@startuml
title Warmhouse User Management Code Diagram

top to bottom direction

!includeurl https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Component.puml

class User {
  +String name
  +String email
  +List<Subscription> memberships
  +List<Roles> roles
  +void register()
  +void login()
  +void logout()
}

class Subscription {
  +String type
  +Date startDate
  +Date endDate
  +void activate()
  +void cancel()
}

class House {
   +String city
   +String address
   +void addHouse()
   +void removeHouse()
   +void updateHouse()
}

class Roles {
    +Boolean isAdmin
    +Boolean isOwner
    +void updateRole()
}


User "1" -- "0..1" Subscription : has
User "1" -- "1..*" House : has
User "1" -- "0..*" Roles : has
@enduml
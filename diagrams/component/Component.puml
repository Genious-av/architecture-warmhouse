@startuml
title Warmhouse Web Application Component Diagram

top to bottom direction

!include C4_Component.puml

Container_Boundary(WarmhouseSystem, "Warmhouse System") {
  Container(GatewayService, "Gateway Service", "Java, Spring", "Handles user interactions")
  Container(UserManagerService, "User Management Service", "Java, Spring", "Handles user data")
  Container(SubscriptionService, "Subscription Service", "Java, Spring", "Handles user payments")
  Container(SensorManagementService, "Sensor management Service", "Java, Spring", "Handles sensor management")
}

Container(GatewayService, "Gateway Service", "Java, Spring") {
  Component(AuthController, "AuthController", "Handles authentication and authorization")
  Component(UserController, "UserController", "Manages user profiles")
  Component(ScenariosController, "ScenariosController", "Manages sensor scenarios")
  Component(DeviceController, "DeviceController", "Manages device installation")
  Component(SubscriptionsController, "SubscriptionsController", "Handles payment processing")
  Component(ServiceLayer, "Service Layer", "Business logic")
  Component(UserManagerServiceClientApi, "User Management Service Client Api", "User management logic")
  Component(UserSubscriptionServiceClientApi, "User Subscription Service Client Api", "User subscription logic")
  Component(SensorManagementServiceClientApi, "Sensor Management Service Client Api", "Sensor management logic")

}

Rel(AuthController,ServiceLayer,"Calls business logic")
Rel(UserController,ServiceLayer,"Calls business logic")
Rel(DeviceController,ServiceLayer,"Calls business logic")
Rel(ScenariosController,ServiceLayer,"Calls business logic")
Rel(SubscriptionsController,ServiceLayer,"Calls business logic")
Rel(ServiceLayer,UserManagerServiceClientApi,"Process user management logic")
Rel(ServiceLayer,UserSubscriptionServiceClientApi,"Process user management logic")
Rel(ServiceLayer,SensorManagementServiceClientApi,"Process user management logic")
Rel(UserManagerServiceClientApi,UserManagerService,"Handles user management service interaction")
Rel(SensorManagementServiceClientApi,SensorManagementService,"Handles sensor data service interaction")
Rel(UserSubscriptionServiceClientApi,SubscriptionService,"Handles user subscription service interaction")
@enduml